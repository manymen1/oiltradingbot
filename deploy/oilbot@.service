[Unit]
Description=Oil observation %i (no broker execution)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/poly/oiltradingbot
ExecStart=%h/poly/oiltradingbot/.venv/bin/python -m oilbot record --component %i --config configs/oil/observe.yaml
Restart=on-failure
RestartSec=30
TimeoutStopSec=200
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
