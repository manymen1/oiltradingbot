  "question": "Israel x Iran ceasefire continues through...?",
  "rule_clauses": [
    {
      "clause_id": "clause_03486d7b0303d22e4461",
      "text": "The occurrence, attribution, and timing of a qualifying military action will be primarily determined based on a consensus of information available from the resolution sources."
    },
    {
      "clause_id": "clause_0eda50c7da9a3cd19261",
      "text": "Small-arms fire;"
    },
    {
      "clause_id": "clause_0ffdb3cc370dba12eeea",
      "text": "Where territorial borders are disputed, all territory claimed by and under the de facto control of the relevant state as of market creation will qualify."
    },
    {
      "clause_id": "clause_14dbefd2720c8d1a036f",
      "text": "MLRS systems);"
    },
    {
      "clause_id": "clause_30325fa9a5ce51658e90",
      "text": "The following actions do not constitute a qualifying military action:"
    },
    {
      "clause_id": "clause_374aef8364f8ba26b6b3",
      "text": "A state of ceasefire will be considered to no longer be in effect between Israel and Iran if either Israel or Iran takes a qualifying military action against the other country between market creation and the listed date, 11:59 PM IRST."
    },
    {
      "clause_id": "clause_41c08418d25cdab6b0a6",
      "text": "A surface-to-surface missile strike includes one-way attack drones and surface-to-surface missiles such as cruise or ballistic missiles."
    },
    {
      "clause_id": "clause_68bcff37d9c40bd63fd8",
      "text": "Cyber operations;"
    },
    {
      "clause_id": "clause_695ea41681bb109fa61b",
      "text": "Ground incursions;"
    },
    {
      "clause_id": "clause_6afd93e1e0d15657bab8",
      "text": "Maritime territory and airspace are not encompassed."
    },
    {
      "clause_id": "clause_6c9692e2b0c779dae256",
      "text": "Any threat, authorization, or announcement of force that has not been executed."
    },
    {
      "clause_id": "clause_6d351f38f8d15ae36f22",
      "text": "If, at the end of the third calendar day, conflicting reports remain as to the occurrence, attribution, or timing of the action, this market will resolve based on the totality of information available from the resolution sources at that time."
    },
    {
      "clause_id": "clause_788ae0a602df76b0ef72",
      "text": "Otherwise this market will resolve to \u201cNo\u201d."
    },
    {
      "clause_id": "clause_7a6f8b56f1514e1e328e",
      "text": "If this period would extend past the end date, this market will remain open to allow for 3 full calendar days to pass."
    },
    {
      "clause_id": "clause_7d497f31b56158834347",
      "text": "An air strike includes bombs, air-to-surface missiles, and air-launched drones."
    },
    {
      "clause_id": "clause_7ed26c771d53071709f4",
      "text": "Where multiple sources conflict regarding the occurrence, attribution, or timing of a relevant military action, this market will remain open until the earlier of: i) the confirmation of the occurrence, attribution, and timing of the action based on a consensus of information available from the resolution sources or ii) 3 full calendar days (IRST) from the date of the first credibly reported evidence of the action."
    },
    {
      "clause_id": "clause_8232dd53fc654e296eb9",
      "text": "A military action will be considered to impact Israel or Iran if it directly impacts the terrestrial territory of Israel or Iran, including any internal waters."
    },
    {
      "clause_id": "clause_989f40937d44e658bc60",
      "text": "Howitzers, artillery pieces, mortars, and rocket artillery (e.g."
    },
    {
      "clause_id": "clause_98bd98177a69c16ec3a9",
      "text": "The resolution sources for this market will be official information from the governments and militaries of Israel and Iran and credible reporting."
    },
    {
      "clause_id": "clause_997cfe4228a6880c8a48",
      "text": "This market will resolve to \"Yes\" if a state of ceasefire remains in effect between Israel and Iran through the listed date, 11:59 PM Iran Standard Time (IRST)."
    },
    {
      "clause_id": "clause_af1a3e74b42d83fe4fe9",
      "text": "Surface-to-air missile strikes;"
    },
    {
      "clause_id": "clause_b192e6bf825955162703",
      "text": "Munitions destroyed or intercepted before impact;"
    },
    {
      "clause_id": "clause_bd8925ae4e4b5eff5b63",
      "text": "Any munition that is intercepted or destroyed before impact does not constitute a qualifying military action."
    },
    {
      "clause_id": "clause_c0c18a1fe9e53c39f3a3",
      "text": "A qualifying military action refers to an air strike or a surface-to-surface missile strike, initiated by Israel or Iran, that directly impacts the other country."
    },
    {
      "clause_id": "clause_cb15fa4473ff55398442",
      "text": "Naval gunfire and artillery fire;"
    },
    {
      "clause_id": "clause_e803ede47c92a9d1674b",
      "text": "Debris, fragments, or any wreckage from intercepted munitions that land on Israel or Iran do not constitute a military action regardless of any damage incurred."
    },
    {
      "clause_id": "clause_eb95e95275d55676a648",
      "text": "No single statement, denial, or presentation of evidence will govern where it is contradicted by the totality of information."
    },
    {
      "clause_id": "clause_eff4ef24b8014a09ba7b",
      "text": "Minor surface-to-surface strikes, including short range loitering munitions, FPV drones, and ATGM strikes;"
    }
  ],
